{
  "encoder": {
    "model": "claude-haiku-3-5",
    "min_confidence": 0.6,
    "categories_enabled": [
      "code-pattern",
      "preference",
      "mental-model",
      "architecture-decision",
      "anti-pattern",
      "workflow",
      "glossary"
    ],
    "two_pass_enabled": true,
    "relation_similarity_threshold": 0.82,
    "relation_top_k": 8,
    "context_window_size": 10
  },
  "workflow_detection": {
    "min_steps": 3,
    "boundary": "user_turn",
    "syntactic_detector_enabled": false
  },
  "retriever": {
    "top_k_vector": 5,
    "graph_hops": 1,
    "min_vector_sim": 0.0,
    "rerank_weights": {
      "recency": 0.25,
      "confidence": 0.3,
      "reinforcements": 0.25,
      "graph_distance": 0.2
    },
    "workflow_lookup_enabled": true,
    "default_visibility_filter": "open_or_same_session"
  },
  "consolidator": {
    "cron": "0 3 * * *",
    "skip_if_active_within_minutes": 15,
    "promotion_threshold_reinforcements": 3,
    "promotion_threshold_confidence": 0.9,
    "merge_similarity_threshold": 0.85,
    "conflict_similarity_threshold": 0.7
  },
  "decay": {
    "score_threshold": 60,
    "category_multipliers": {}
  },
  "neo4j": {
    "bolt_uri": "bolt://127.0.0.1:7687",
    "browser_uri": "http://127.0.0.1:7474",
    "auth": "none",
    "container_name": "mnemosyne-neo4j",
    "image": "neo4j:5-community"
  },
  "chroma": {
    "host": "127.0.0.1",
    "port": 8765,
    "embedding_model": "minilm",
    "embedding_model_used_at_index_time": "minilm"
  },
  "privacy": {
    "default_visibility": "open",
    "exclude_sessions": [],
    "exclude_categories": [],
    "cross_session_retrieval": true
  },
  "workflow_replay": {
    "confirm_each_step": true,
    "auto_execute_safe_steps": false
  },
  "pipeline": {
    "v12_enabled": false
  },
  "triage_v12": {
    "model": "haiku"
  },
  "classify_v12": {
    "model": "haiku",
    "max_candidates_per_turn": 5,
    "fallback_reclassify_on_low_conf_new_category": true
  },
  "categories_v12": {
    "new_category_min_confidence": 0.7,
    "new_category_recurrence_window_days": 7,
    "new_category_recurrence_min_occurrences": 2,
    "pending_path": "~/.jarvis/mnemosyne/pending-categories.json",
    "categories_dir": "~/.jarvis/mnemosyne/categories/"
  },
  "relate_v12": {
    "enabled": true,
    "model": "haiku",
    "top_k": 20,
    "similarity_threshold": 0.55,
    "judge_cap_per_memory": 20,
    "intra_turn_max_pairs": 3,
    "async": true
  },
  "graph_retrieval": {
    "enabled": false,
    "max_parents": 10,
    "max_children": 20
  },
  "session_blacklist": {
    "_comment": "Regex patterns (tested via RegExp.test(sessionId)). Matching sessions are excluded from memory injection AND background review.",
    "patterns": [
      "mnemosyne-skip",
      "^slack-connector-"
    ]
  },
  "background_review": {
    "_comment": "Hermes-first cognitive curation. Set enabled:true to activate periodic memory extraction.",
    "enabled": false,
    "reviewEveryNTurns": 5,
    "idleTriggerMinutes": 10,
    "timeoutSeconds": 90
  }
}