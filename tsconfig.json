{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@jarvis/core": ["../../../dev/personal/jarvis-app/packages/core/src/index.ts"]
    }
  },
  "include": ["pieces/**/*", "lib/**/*", "renderers/**/*", "test/**/*", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
